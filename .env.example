# Copy this to .env and fill in values
# cp .env.example .env

# PostgreSQL
POSTGRES_USER=tcg
POSTGRES_PASSWORD=tcgpass
POSTGRES_DB=tcgdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
LOG_LEVEL=info

# Pokemon TCG API (free at https://pokemontcg.io)
POKEMON_TCG_API_KEY=

# PSA (optional - for enhanced cert lookup)
PSA_API_KEY=

# Scraper settings
PRICECHARTING_RATE_LIMIT_SECONDS=3
SCRAPE_CACHE_TTL_PRICES=86400
SCRAPE_CACHE_TTL_METADATA=604800

# CORS origins for mobile app (comma-separated)
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@tcg.com
PGADMIN_PASSWORD=admin
